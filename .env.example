# INKubiertos - Environment Variables (EXAMPLE - DO NOT COMMIT REAL CREDENTIALS)
# Copy to .env and fill with real values

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Streamlit (if using secrets)
# Use .streamlit/secrets.toml for Streamlit Cloud/Local
# [supabase]
# url = "..."
# key = "..."

# Auth configuration (if applicable)
# AUTH_ENABLED=false
# SESSION_TIMEOUT_MINUTES=60
