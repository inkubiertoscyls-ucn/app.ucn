# INKubiertos - Variables de entorno (EJEMPLO - NO SUBIR CREDENCIALES REALES)
# Copiar a .env y completar con los valores reales.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
# Clave pública (publishable / anon). Nunca pongas aquí la clave secreta.
SUPABASE_KEY=sb_publishable_xxx
# Clave secreta (secret / service_role). La usa SOLO el servidor de Streamlit;
# el navegador nunca la ve. Necesaria para activar RLS (db/migrations/005_enable_rls.sql).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Aplicación
APP_ENV=development
LOG_LEVEL=INFO
# Minutos de inactividad antes de cerrar la sesión automáticamente.
SESSION_TIMEOUT_MINUTES=60

# Streamlit Cloud: usar .streamlit/secrets.toml con el mismo contenido
# [supabase]
# url = "..."
# key = "..."
# service_role_key = "..."
